<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>建水紫陶 - 3D模型展示</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-kai), var(--font-song), serif;
            background: linear-gradient(160deg, #eef3ef 0%, #dbe9e2 30%, #b5cdc3 70%, #7aa89a 100%);
            min-height: 100vh;
            color: #3a3226;
            overflow: hidden;
        }

        header {
            text-align: center;
            padding: 16px 20px;
            background: rgba(255, 253, 247, 0.75);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(16, 185, 129, 0.12);
            box-shadow: 0 2px 16px rgba(16, 185, 129, 0.06);
        }

        header h1 {
            font-size: 1.6em;
            font-weight: 700;
            color: #3a6b5f;
            letter-spacing: 1px;
        }

        header p {
            color: #5a8a78;
            font-size: 0.85em;
            margin-top: 4px;
        }

        .main-container {
            display: flex;
            height: calc(100vh - 80px);
            gap: 0;
        }

        .model-display-section {
            flex: 6;
            position: relative;
            background: linear-gradient(135deg, rgba(110, 231, 183, 0.15) 0%, rgba(52, 211, 153, 0.08) 50%, rgba(16, 185, 129, 0.12) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .model-3d-wrapper {
            width: 90%;
            height: 90%;
            background: rgba(255, 253, 247, 0.9);
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(16, 185, 129, 0.2), 0 2px 8px rgba(0, 0, 0, 0.04);
            border: 2px solid rgba(16, 185, 129, 0.15);
            position: relative;
            overflow: hidden;
        }

        .model-3d-canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .model-loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(255, 253, 247, 0.95);
            z-index: 10;
            transition: opacity 0.5s ease;
        }

        .model-loading-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .loading-spinner {
            width: 48px;
            height: 48px;
            border: 4px solid rgba(16, 185, 129, 0.15);
            border-top-color: #3a6b5f;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .loading-text {
            margin-top: 16px;
            color: #3a6b5f;
            font-size: 0.95em;
            font-weight: 500;
        }

        .model-controls-hint {
            position: absolute;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(16, 185, 129, 0.08);
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 0.82em;
            color: #3a6b5f;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(16, 185, 129, 0.15);
            white-space: nowrap;
        }

        .zoom-controls {
            position: absolute;
            bottom: 60px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 5;
        }

        .zoom-btn {
            width: 36px;
            height: 36px;
            border: none;
            background: rgba(255, 253, 247, 0.9);
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
            font-weight: bold;
            color: #3a6b5f;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.2);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .zoom-btn:hover {
            transform: scale(1.1);
            background: #fff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
        }

        .fullscreen-btn {
            width: 36px;
            height: 36px;
            border: none;
            background: linear-gradient(135deg, #4e7a6c 0%, #3a6b5f 100%);
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
            color: #fff;
            box-shadow: 0 3px 12px rgba(16, 185, 129, 0.35);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .fullscreen-btn:hover {
            transform: scale(1.15) rotate(90deg);
            background: linear-gradient(135deg, #10b981 0%, #047857 100%);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
        }

        .info-section {
            flex: 4;
            background: rgba(255, 253, 247, 0.75);
            backdrop-filter: blur(12px);
            border-left: 1px solid rgba(16, 185, 129, 0.1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .info-header {
            padding: 28px 32px 20px;
            border-bottom: 1px solid rgba(16, 185, 129, 0.1);
            background: rgba(255, 253, 247, 0.5);
        }

        .info-header h2 {
            font-size: 1.5em;
            color: #047857;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .info-header .subtitle {
            font-size: 0.92em;
            color: #5a8a78;
            font-weight: 500;
        }

        .info-content-scrollable {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 28px 32px;
            scrollbar-width: thin;
            scrollbar-color: rgba(16, 185, 129, 0.3) transparent;
        }

        .info-content-scrollable::-webkit-scrollbar {
            width: 6px;
        }

        .info-content-scrollable::-webkit-scrollbar-track {
            background: transparent;
        }

        .info-content-scrollable::-webkit-scrollbar-thumb {
            background: rgba(16, 185, 129, 0.3);
            border-radius: 3px;
        }

        .info-content-scrollable::-webkit-scrollbar-thumb:hover {
            background: rgba(16, 185, 129, 0.5);
        }

        .info-block {
            margin-bottom: 22px;
        }

        .info-block-title {
            font-size: 1.05em;
            font-weight: 600;
            color: #047857;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-text {
            line-height: 1.75;
            color: #2d4a3f;
            font-size: 0.93em;
        }

        .info-text strong {
            color: #047857;
            font-weight: 600;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            margin-top: 18px;
        }

        .feature-item {
            background: rgba(16, 185, 129, 0.06);
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 0.88em;
            color: #047857;
            text-align: center;
            font-weight: 600;
            border: 1px solid rgba(16, 185, 129, 0.12);
            transition: all 0.25s ease;
        }

        .feature-item:hover {
            background: rgba(16, 185, 129, 0.12);
            transform: translateY(-2px);
        }

        .process-link-section {
            padding: 24px 32px;
            background: linear-gradient(135deg, rgba(110, 231, 183, 0.2) 0%, rgba(16, 185, 129, 0.15) 100%);
            border-top: 1px solid rgba(16, 185, 129, 0.15);
        }

        .process-link-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 16px 24px;
            background: linear-gradient(135deg, #4e7a6c 0%, #3a6b5f 100%);
            color: #fff;
            text-decoration: none;
            border-radius: 14px;
            font-size: 1.05em;
            font-weight: 600;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            cursor: pointer;
        }

        .process-link-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 28px rgba(16, 185, 129, 0.5);
            background: linear-gradient(135deg, #4e7a6c 0%, #047857 100%);
        }

        .process-link-button:active {
            transform: translateY(-1px);
        }

        .process-icon {
            font-size: 1.3em;
        }

        @media (max-width: 1024px) {
            .main-container {
                flex-direction: column;
            }

            .model-display-section {
                flex: 1;
                min-height: 45vh;
            }

            .info-section {
                flex: 1;
                border-left: none;
                border-top: 1px solid rgba(16, 185, 129, 0.1);
            }
        }
    </style>
  <link rel="stylesheet" href="theme/gufeng.css">
</head>
<body>
    <header>
        <h1>🏺 建水紫陶 - 传统非遗文化</h1>
        <p>3D数字模型展示 · 交互式浏览体验</p>
    </header>

    <div class="main-container">
        <div class="model-display-section" id="modelDisplaySection">
            <div class="model-3d-wrapper" id="model3DWrapper">
                <canvas id="threeCanvas" class="model-3d-canvas"></canvas>

                <div class="model-loading-overlay" id="loadingOverlay">
                    <div class="loading-spinner"></div>
                    <div class="loading-text">正在加载3D建水紫陶模型...</div>
                </div>

                <div class="model-controls-hint">
                    🖱 拖拽旋转 · 滚轮缩放 · 右键平移
                </div>

                <div class="zoom-controls">
                    <button class="zoom-btn" id="zoomInBtn" title="放大">+</button>
                    <button class="zoom-btn" id="zoomOutBtn" title="缩小">−</button>
                    <button class="fullscreen-btn" id="fullscreenBtn" title="全屏展示">⛶</button>
                </div>
            </div>
        </div>

        <div class="info-section">
            <div class="info-header">
                <h2>模型二 · 建水紫陶</h2>
                <div class="subtitle">国家级非物质文化遗产</div>
            </div>

            <div class="info-content-scrollable" id="infoContentScrollable">
                <div class="info-block">
                    <div class="info-block-title">🏛️ 地区分布</div>
                    <div class="info-text">
                        云南省红河哈尼族彝族自治州<strong>建水县</strong>，被誉为"滇南琼玉"
                    </div>
                </div>

                <div class="info-block">
                    <div class="info-block-title">📜 非遗等级</div>
                    <div class="info-text">
                        国家级非物质文化遗产（2008年列入第二批国家级非遗名录）。<br><br>
                        建水紫陶与江苏宜兴陶、广东石湾陶、四川荣昌陶并称<strong>"中国四大名陶"</strong>。
                    </div>
                </div>

                <div class="info-block">
                    <div class="info-block-title">🏺 文化简介</div>
                    <div class="info-text">
                        建水紫陶烧制技艺于<strong>2008年列入第二批国家级非物质文化遗产代表性项目名录</strong>。其制作工艺独特，以<strong>"阴刻阳填、无釉磨光"</strong>为核心技法，成品坚实温润，素有"质如铁、亮如镜、润如玉、声如磬"之美誉。<br><br>

                        <strong>主要工艺流程包括：</strong><br>
                        • <strong>选料：</strong>选用建水五彩山红、黄、紫、青、白五色土<br>
                        • <strong>制泥：</strong>镇浆制泥、淘洗陈腐，泥质"腻如膏脂"<br>
                        • <strong>成型：</strong>手工拉坯、修坯造型<br>
                        • <strong>装饰：</strong>湿坯阴刻阳填，嵌以书画"残帖"<br>
                        • <strong>烧制：</strong>高温焙烧（1000℃-1200℃），成器"声如磬"<br>
                        • <strong>磨光：</strong>无釉磨光、精细抛光，温润如玉<br><br>

                        建水紫陶以其<strong>独特的"残帖"装饰艺术</strong>和精湛的无釉磨光工艺闻名于世，具有极高的实用价值和收藏价值。
                    </div>
                </div>

                <div class="features-grid">
                    <div class="feature-item">✨ 中国四大名陶</div>
                    <div class="feature-item">🖌 阴刻阳填</div>
                    <div class="feature-item">🔥 无釉磨光</div>
                    <div class="feature-item">🏺 文人陶韵</div>
                </div>
            </div>

            <div class="process-link-section">
                <a href="process2.html" class="process-link-button" id="processLinkButton">
                    <span class="process-icon">🔧</span>
                    <span>查看建水紫陶制作流程</span>
                </a>
            </div>
        </div>
    </div>

    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
        }
    }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
        import { MTLLoader } from 'three/addons/loaders/MTLLoader.js';

        const canvas = document.getElementById('threeCanvas');
        const wrapper = document.getElementById('model3DWrapper');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const zoomInBtn = document.getElementById('zoomInBtn');
        const zoomOutBtn = document.getElementById('zoomOutBtn');

        let scene, camera, renderer, controls;
        let isInitialized = false;

        function initThreeJS() {
            if (isInitialized) return;
            isInitialized = true;

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xffffff);

            const aspect = canvas.clientWidth / canvas.clientHeight;
            camera = new THREE.PerspectiveCamera(45, aspect, 0.1, 1000);
            camera.position.set(5, 3, 5);

            renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                antialias: true,
                alpha: true
            });
            renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.2;

            const ambientLight = new THREE.AmbientLight(0xfff5e0, 1.5);
            scene.add(ambientLight);

            const keyLight = new THREE.DirectionalLight(0xffffff, 4);
            keyLight.position.set(5, 8, 5);
            keyLight.castShadow = true;
            keyLight.shadow.mapSize.width = 2048;
            keyLight.shadow.mapSize.height = 2048;
            keyLight.shadow.camera.near = 0.5;
            keyLight.shadow.camera.far = 50;
            keyLight.shadow.camera.left = -10;
            keyLight.shadow.camera.right = 10;
            keyLight.shadow.camera.top = 10;
            keyLight.shadow.camera.bottom = -10;
            keyLight.shadow.bias = -0.0001;
            scene.add(keyLight);

            const fillLight = new THREE.DirectionalLight(0xffe0b0, 2);
            fillLight.position.set(-3, 2, -3);
            scene.add(fillLight);

            const rimLight = new THREE.DirectionalLight(0xffffff, 1.5);
            rimLight.position.set(0, 1, -5);
            scene.add(rimLight);

            const groundGeometry = new THREE.PlaneGeometry(20, 20);
            const groundMaterial = new THREE.ShadowMaterial({ opacity: 0.3 });
            const ground = new THREE.Mesh(groundGeometry, groundMaterial);
            ground.rotation.x = -Math.PI / 2;
            ground.position.y = -2;
            ground.receiveShadow = true;
            scene.add(ground);

            controls = new OrbitControls(camera, renderer.domElement);
            controls.target.set(0, 0.5, 0);
            controls.enableDamping = true;
            controls.dampingFactor = 0.08;
            controls.minDistance = 2.5;
            controls.maxDistance = 12;
            controls.maxPolarAngle = Math.PI * 0.75;
            controls.minPolarAngle = 0.2;
            controls.autoRotate = true;
            controls.autoRotateSpeed = 0.5;
            controls.enableZoom = false;

            wrapper.addEventListener('wheel', handleWheelZoom, { passive: false });

            controls.update();

            loadingOverlay.classList.remove('hidden');

            const mtlLoader = new MTLLoader();
            const objLoader = new OBJLoader();

            const mtlPath = encodeURI('模型二模型/ceramic vase 3d model/ceramic+vase+3d+model.mtl');
            const objPath = encodeURI('模型二模型/ceramic vase 3d model/ceramic+vase+3d+model.obj');

            mtlLoader.load(mtlPath, (materials) => {
                materials.preload();
                objLoader.setMaterials(materials);

                objLoader.load(objPath,
                    (object) => {
                        console.log('建水紫陶模型加载成功');

                        object.traverse((child) => {
                            if (child.isMesh) {
                                child.castShadow = true;
                                child.receiveShadow = true;
                            }
                        });

                        const box = new THREE.Box3().setFromObject(object);
                        const size = box.getSize(new THREE.Vector3());
                        const maxDim = Math.max(size.x, size.y, size.z);
                        const scale = 4 / maxDim;
                        object.scale.multiplyScalar(scale);

                        box.setFromObject(object);
                        const center = box.getCenter(new THREE.Vector3());
                        object.position.sub(center);

                        scene.add(object);

                        setTimeout(() => {
                            loadingOverlay.classList.add('hidden');
                        }, 800);
                    },
                    (xhr) => {
                        if (xhr.lengthComputable) {
                            const percent = Math.round((xhr.loaded / xhr.total) * 100);
                            const textEl = loadingOverlay.querySelector('.loading-text');
                            if (textEl) {
                                const loadedMB = (xhr.loaded / 1024 / 1024).toFixed(2);
                                const totalMB = (xhr.total / 1024 / 1024).toFixed(2);
                                textEl.textContent = `正在加载3D建水紫陶模型... ${percent}% (${loadedMB}MB / ${totalMB}MB)`;
                            }
                        }
                    },
                    (error) => {
                        console.error('OBJ模型加载错误:', error);
                        const textEl = loadingOverlay.querySelector('.loading-text');
                        if (textEl) {
                            textEl.innerHTML = '⚠️ 模型加载失败<br><span style="font-size: 0.85em; color: #666;">请检查文件路径或刷新页面重试</span>';
                        }
                        const spinnerEl = loadingOverlay.querySelector('.loading-spinner');
                        if (spinnerEl) spinnerEl.style.borderTopColor = '#a5372f';
                    }
                );
            }, undefined, (error) => {
                console.error('MTL材质加载错误:', error);

                objLoader.load(objPath,
                    (object) => {
                        console.log('建水紫陶模型加载成功（无材质）');

                        object.traverse((child) => {
                            if (child.isMesh) {
                                child.castShadow = true;
                                child.receiveShadow = true;
                                child.material = new THREE.MeshStandardMaterial({
                                    color: 0x8b4513,
                                    roughness: 0.7,
                                    metalness: 0.1
                                });
                            }
                        });

                        const box = new THREE.Box3().setFromObject(object);
                        const size = box.getSize(new THREE.Vector3());
                        const maxDim = Math.max(size.x, size.y, size.z);
                        const scale = 4 / maxDim;
                        object.scale.multiplyScalar(scale);

                        box.setFromObject(object);
                        const center = box.getCenter(new THREE.Vector3());
                        object.position.sub(center);

                        scene.add(object);

                        setTimeout(() => {
                            loadingOverlay.classList.add('hidden');
                        }, 800);
                    },
                    (xhr) => {
                        if (xhr.lengthComputable) {
                            const percent = Math.round((xhr.loaded / xhr.total) * 100);
                            const textEl = loadingOverlay.querySelector('.loading-text');
                            if (textEl) {
                                const loadedMB = (xhr.loaded / 1024 / 1024).toFixed(2);
                                const totalMB = (xhr.total / 1024 / 1024).toFixed(2);
                                textEl.textContent = `正在加载3D建水紫陶模型... ${percent}% (${loadedMB}MB / ${totalMB}MB)`;
                            }
                        }
                    },
                    (error) => {
                        console.error('模型加载完全失败:', error);
                        const textEl = loadingOverlay.querySelector('.loading-text');
                        if (textEl) {
                            textEl.innerHTML = '⚠️ 模型加载失败<br><span style="font-size: 0.85em; color: #666;">请检查文件路径或刷新页面重试</span>';
                        }
                        const spinnerEl = loadingOverlay.querySelector('.loading-spinner');
                        if (spinnerEl) spinnerEl.style.borderTopColor = '#a5372f';
                    }
                );
            });

            function animate() {
                if (!isInitialized) return;
                requestAnimationFrame(animate);
                controls.update();
                renderer.render(scene, camera);
            }

            animate();
        }

        function handleWheelZoom(event) {
            event.preventDefault();
            event.stopPropagation();

            const delta = event.deltaY * 0.001;
            const direction = new THREE.Vector3().subVectors(camera.position, controls.target).normalize();
            const distance = camera.position.distanceTo(controls.target);
            let newDistance;

            if (delta > 0) {
                newDistance = Math.min(distance * 1.15, controls.maxDistance);
            } else {
                newDistance = Math.max(distance * 0.85, controls.minDistance);
            }

            camera.position.copy(controls.target).add(direction.multiplyScalar(newDistance));
            controls.update();
        }

        function handleResize() {
            if (!camera || !renderer || !canvas) return;

            const width = canvas.clientWidth || window.innerWidth;
            const height = canvas.clientHeight || window.innerHeight;

            if (width <= 0 || height <= 0) return;

            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height, false);

            if (controls) {
                controls.update();
            }

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            handleResize();
        });

        zoomInBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (controls && camera) {
                const direction = new THREE.Vector3().subVectors(camera.position, controls.target).normalize();
                const distance = camera.position.distanceTo(controls.target);
                const newDistance = Math.max(distance * 0.8, controls.minDistance);
                camera.position.copy(controls.target).add(direction.multiplyScalar(newDistance));
                controls.update();
            }
        });

        zoomOutBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (controls && camera) {
                const direction = new THREE.Vector3().subVectors(camera.position, controls.target).normalize();
                const distance = camera.position.distanceTo(controls.target);
                const newDistance = Math.min(distance * 1.25, controls.maxDistance);
                camera.position.copy(controls.target).add(direction.multiplyScalar(newDistance));
                controls.update();
            }
        });

        const fullscreenBtn = document.getElementById('fullscreenBtn');

        fullscreenBtn.addEventListener('click', () => {
            window.location.href = 'model2_fullscreen.html';
        });

        initThreeJS();
    </script>
</body>
</html>