# ============================================================
#  华夏风物 · 非遗传承平台 —— 后端环境变量模板
# ------------------------------------------------------------
#  使用方法：
#    1. 复制本文件为 .env        （命令：copy .env.example .env）
#    2. 按下面说明修改各项配置
#    3. .env 已被 .gitignore 忽略，不会提交到仓库，可安全存放密钥
#
#  ⚠️ 请用 UTF-8 编码保存（勿用记事本另存为 UTF-16，会导致读取失败）
# ============================================================

# ---------- 服务端口 ----------
# 本地默认 3000；部署到云服务器/PaaS 平台时通常由平台注入 PORT，无需手动改
PORT=3000

# 监听地址：0.0.0.0 = 允许外部访问（部署必需）；127.0.0.1 = 仅本机可访问
HOST=0.0.0.0

# 运行环境：production 时访问日志使用 combined 格式
NODE_ENV=development

# ---------- 安全密钥（★部署前必须修改）----------
# JWT 令牌签名密钥：一旦泄露，他人可伪造任意用户（含管理员）登录
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_请替换为随机长字符串

# 支付回调校验令牌（模拟支付回调时使用）
PAYMENT_CALLBACK_TOKEN=CHANGE_ME_请替换为随机字符串

# ---------- 跨域白名单 ----------
# 留空 = 不开放跨域（前后端部署在同一域名下时无需配置，最安全）
# 若前端单独部署，填写前端地址，多个用英文逗号分隔，例如：
#   CORS_ORIGIN=https://example.com,https://www.example.com
CORS_ORIGIN=

# ---------- MySQL 数据库配置（当前数据层已切换为 MySQL）----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=heritage
DB_CONNECTION_LIMIT=10

# ---------- 密码与登录安全 ----------
# bcrypt 强度因子（cost）：每 +1 计算耗时翻倍，12 为当前推荐值
# 老用户的哈希会在下次成功登录时自动升级到该强度
BCRYPT_COST=12

# ---------- 日志与反向代理 ----------
# LOG_ACCESS=off 可关闭访问日志（默认开启）
LOG_ACCESS=on
# 经 Nginx 等反向代理部署时设为 1，访问日志与限流才能取到真实客户端 IP
TRUST_PROXY=0
